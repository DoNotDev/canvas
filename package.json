{
  "name": "@donotdev/canvas",
  "version": "0.2.0",
  "private": false,
  "type": "module",
  "license": "MIT",
  "description": "Agent-facing UI widget catalog for DoNotDev — renders allowlisted canvas blocks emitted by LLM agents",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "tsc --noEmit --watch --listFiles false --listEmittedFiles false",
    "clean": "rimraf dist tsconfig.tsbuildinfo",
    "type-check": "bunx tsc --noEmit"
  },
  "dependencies": {
    "@donotdev/core": "workspace:*",
    "valibot": "^1.5.0"
  },
  "peerDependencies": {
    "@donotdev/components": "workspace:*",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@donotdev/components": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "files": [
    "dist",
    "package.json",
    "README.md",
    "LICENSE.md"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/donotdev/canvas.git"
  },
  "keywords": [
    "donotdev",
    "dndev",
    "canvas",
    "ai",
    "agent",
    "llm",
    "widgets",
    "react",
    "typescript"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "peerDependenciesMeta": {}
}
